{
  "name": "mpv-gotorrent",
  "identifier": "io.github.biohazard786.gotorrent",
  "version": "1.1.0",
  "ghRepo": "biohazard786/mpv-gotorrent",
  "ghVersion": 2,
  "description": "Stream BitTorrent magnet links & torrents directly inside IINA with zero SSD wear",
  "author": {
    "name": "biohazard786",
    "url": "https://github.com/biohazard786/mpv-gotorrent"
  },
  "entry": "main.js",
  "globalEntry": "global.js",
  "permissions": ["show-osd", "show-alert", "file-system", "network-request"],
  "allowedDomains": [
    "127.0.0.1",
    "localhost",
    "github.com",
    "objects.githubusercontent.com"
  ],
  "preferencesPage": "ui/preferences.html",
  "preferenceDefaults": {
    "port": 8989,
    "max_ram_mb": 0,
    "timeout": 60,
    "keep_dir": "",
    "keep_scope": "current",
    "auto_playlist": true,
    "max_cached_files": 3,
    "max_upload_kbps": 0,
    "max_download_kbps": 0,
    "seed_ratio": 0
  },
  "sidebarTab": {
    "name": "BitTorrent",
    "icon": "arrow.down.circle"
  }
}
